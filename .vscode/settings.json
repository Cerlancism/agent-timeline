{
  // Matches .gitattributes (`* text=auto eol=lf`). This machine has
  // core.autocrlf=true globally, so without both, editing a .bash script here
  // reintroduces CRLF and bash fails it with "bad interpreter: ...^M".
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "explorer.copyRelativePathSeparator": "/",
  "[plaintext]": {
    "files.trimTrailingWhitespace": false
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "files.associations": {
    "*.bash": "shellscript",
    "*.jsonl": "jsonl"
  }
}
